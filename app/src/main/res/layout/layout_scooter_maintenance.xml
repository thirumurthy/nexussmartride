<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_card_cyber"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Service"
                                        android:src="@drawable/ic_wrench"
                                        app:tint="@color/primary_cyan" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/jetbrains_mono"
                                        android:letterSpacing="0.1"
                                        android:text="OFFICIAL AMPERE CARE"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:fontFamily="@font/space_grotesk"
                                        android:text="Service Timeline &amp; Health"
                                        android:textColor="@color/text_white"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/tvServiceDueKmBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_pill_cyan"
                                android:fontFamily="@font/jetbrains_mono"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="3,127 km due"
                                android:textColor="@color/primary_cyan"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Next Inspection Milestone Hero Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_card_high"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvServiceTargetTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/inter"
                                    android:text="Next: 6th Service (25,000 km)"
                                    android:textColor="@color/text_white"
                                    android:textSize="14sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvNextServiceMaint"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/space_grotesk"
                                    android:text="25,000 km"
                                    android:textColor="@color/primary_cyan"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />
                            </RelativeLayout>

                            <!-- Milestone Lifecycle Progress Bar -->
                            <ProgressBar
                                android:id="@+id/progressServiceLifecycle"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="6dp"
                                android:layout_marginTop="10dp"
                                android:max="100"
                                android:progress="70"
                                android:progressDrawable="@drawable/bg_tab_pill_active" />

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp">

                                <TextView
                                    android:id="@+id/tvCurrentOdoService"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/jetbrains_mono"
                                    android:text="Current Odo: 21,873 km"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:fontFamily="@font/inter"
                                    android:text="Every 5,000 km Periodic"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="11sp" />
                            </RelativeLayout>
                        </LinearLayout>

                        <!-- Horizontal Scrollable Milestone Graph / Timeline Track -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="8dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.08"
                            android:text="MAINTENANCE TIMELINE GRAPH • TAP MILESTONE"
                            android:textColor="@color/primary_cyan"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <HorizontalScrollView
                            android:id="@+id/scrollMilestonesTrack"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fadeScrollbars="false"
                            android:overScrollMode="never"
                            android:scrollbars="none">

                            <LinearLayout
                                android:id="@+id/layoutMilestonesTrack"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingVertical="4dp" />
                        </HorizontalScrollView>

                        <!-- Dynamic Inspection Checklist for Selected Milestone -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                android:id="@+id/tvSelectedMilestoneTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="25,000 km Service Checklist"
                                android:textColor="@color/text_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvSelectedMilestoneStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_pill_emerald"
                                android:fontFamily="@font/jetbrains_mono"
                                android:paddingHorizontal="6dp"
                                android:paddingVertical="1dp"
                                android:text="UPCOMING TARGET"
                                android:textColor="@color/status_emerald"
                                android:textSize="8sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <LinearLayout
                            android:id="@+id/layoutMilestoneChecklist"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Book Appointment CTA -->
                        <Button
                            android:id="@+id/btnBookService"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:layout_marginTop="14dp"
                            android:background="@drawable/bg_pill_cyan_solid"
                            app:backgroundTint="@color/primary_cyan"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:minHeight="0dp"
                            android:drawableStart="@drawable/ic_calendar"
                            android:drawableTint="@color/black"
                            android:fontFamily="@font/jetbrains_mono"
                            android:paddingHorizontal="16dp"
                            android:text="BOOK SERVICE AT NEXUS HUB"
                            android:textColor="@color/black"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. OWNER PREVENTIVE CARE ROUTINE (Weekly & Monthly Checklists) -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_card_cyber"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Checklist"
                                        android:src="@drawable/ic_check_circle"
                                        app:tint="@color/secondary_green" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/jetbrains_mono"
                                        android:letterSpacing="0.1"
                                        android:text="SELF-MAINTENANCE"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:fontFamily="@font/space_grotesk"
                                        android:text="Owner Maintenance Checklist"
                                        android:textColor="@color/text_white"
                                        android:textSize="16sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_pill_emerald"
                                android:fontFamily="@font/jetbrains_mono"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="10-MIN ROUTINE"
                                android:textColor="@color/secondary_green"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Toggle Pills: Weekly vs Monthly -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card_high"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="2dp">

                            <TextView
                                android:id="@+id/btnTabWeeklyTasks"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@drawable/bg_tab_pill_active"
                                android:gravity="center"
                                android:fontFamily="@font/space_grotesk"
                                android:text="Weekly Tasks (10 min)"
                                android:textColor="@color/text_white"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/btnTabMonthlyTasks"
                                android:layout_width="0dp"
                                android:layout_height="match_parent"
                                android:layout_weight="1"
                                android:background="@android:color/transparent"
                                android:gravity="center"
                                android:fontFamily="@font/space_grotesk"
                                android:text="Monthly Deep Check"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Task Items Container -->
                        <LinearLayout
                            android:id="@+id/layoutOwnerTasks"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. EV VS PETROL SCOOTER MAINTENANCE BURDEN COMPARISON -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_card_cyber"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Savings"
                                        android:src="@drawable/ic_leaf"
                                        app:tint="@color/secondary_green" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/jetbrains_mono"
                                        android:letterSpacing="0.1"
                                        android:text="ENGINEERING COMPARISON"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:fontFamily="@font/space_grotesk"
                                        android:text="Why Nexus EV Needs Less Servicing"
                                        android:textColor="@color/text_white"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_pill_emerald"
                                android:fontFamily="@font/jetbrains_mono"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="60–70% SAVINGS"
                                android:textColor="@color/secondary_green"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Highlight Banner -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card_high"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="₹15,000–₹20,000 Saved on Maintenance (5 Years)"
                                android:textColor="@color/primary_cyan"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/inter"
                                android:lineSpacingExtra="2dp"
                                android:text="A petrol scooter has 100+ moving engine parts requiring periodic oil, spark plug, and valve servicing. Ampere Nexus electric motor has a single moving part (rotor) — eliminating oil changes, air filter swaps, and spark replacements completely."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Key Comparison Table -->
                        <LinearLayout
                            android:id="@+id/layoutEvComparisonList"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 6. BATTERY CARE & MONSOON PREPAREDNESS GUIDELINES -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/glass_border_subtle"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@drawable/bg_card_cyber"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:contentDescription="Battery Care"
                                        android:src="@drawable/ic_bolt"
                                        app:tint="@color/primary_cyan" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="10dp"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/jetbrains_mono"
                                        android:letterSpacing="0.1"
                                        android:text="LFP CHEMISTRY &amp; SAFETY"
                                        android:textColor="@color/text_secondary"
                                        android:textSize="9sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="1dp"
                                        android:fontFamily="@font/space_grotesk"
                                        android:text="Battery Care &amp; Monsoon Protocol"
                                        android:textColor="@color/text_white"
                                        android:textSize="15sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@drawable/bg_pill_cyan"
                                android:fontFamily="@font/jetbrains_mono"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="5-YR WARRANTY"
                                android:textColor="@color/primary_cyan"
                                android:textSize="9sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <!-- Daily Charging Sweet Spot Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_card_high"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="Daily Charging Sweet Spot (80–90%)"
                                android:textColor="@color/secondary_green"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/inter"
                                android:lineSpacingExtra="2dp"
                                android:text="• Charge to 80–90% for regular commutes to minimize cell stress and maximize cycle retention.\n• Avoid letting the battery drop below 10–15% frequently.\n• Full 100% charge the night before a long ride is fine; avoid parking at 100% in direct noon sun.\n• Charge in a shaded room-temperature area."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Monsoon & Brakes Box -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_card_high"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/space_grotesk"
                                android:text="Monsoon Safety &amp; Brake Protocol"
                                android:textColor="@color/primary_cyan"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:fontFamily="@font/inter"
                                android:lineSpacingExtra="2dp"
                                android:text="• IP67 Protected: riding in rain is safe, but always dry the charging socket completely before connecting charger.\n• Do not pressure-wash electrical harness or battery vents directly.\n• Front disc pad: replace when thickness drops below 2 mm.\n• 12-inch tubeless alloy tyres: maintain cold pressure monthly (Front 28, Rear 32 PSI)."
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <!-- Frequently Asked Questions Accordion -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:layout_marginBottom="6dp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:letterSpacing="0.08"
                            android:text="FREQUENTLY ASKED QUESTIONS"
                            android:textColor="@color/primary_cyan"
                            android:textSize="9sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/layoutFaqContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

</LinearLayout>
