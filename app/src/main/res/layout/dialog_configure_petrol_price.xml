<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_cyber"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btnDialogClose"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_pill_cyan">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:contentDescription="Petrol Icon"
                    android:src="@drawable/ic_fuel"
                    app:tint="@color/primary_cyan" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/space_grotesk"
                    android:text="Fuel Savings Benchmark"
                    android:textColor="@color/text_white"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/jetbrains_mono"
                    android:text="City Fuel Rate &amp; ICE Comparison"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnDialogClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- Subtle Cyber Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="#1A00E5FF" />

    <!-- Explanatory note -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:fontFamily="@font/inter"
        android:lineSpacingExtra="2dp"
        android:text="Configure your local city petrol rate and equivalent 110-125cc petrol scooter mileage. All savings displays across the app will recalculate dynamically."
        android:textColor="@color/text_primary"
        android:textSize="11sp" />

    <!-- ── 1. Petrol Price Section ── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="PETROL PRICE (₹ / LITRE)"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/jetbrains_mono"
            android:text="Metro avg: ₹102 - ₹108"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </RelativeLayout>

    <!-- Petrol Price Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_cyber_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:text="₹"
            android:textColor="@color/primary_cyan"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etDialogPetrolPrice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/space_grotesk"
            android:hint="104.0"
            android:imeOptions="actionNext"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="/ LITRE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Price Select Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/chipPrice98"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="₹98"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPrice102"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="₹102"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPrice105"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="₹105"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPrice108"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="₹108"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipPrice112"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="₹112"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── 2. ICE Mileage Section ── -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="ICE BENCHMARK MILEAGE"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:fontFamily="@font/jetbrains_mono"
            android:text="110-125cc Petrol Scooter"
            android:textColor="@color/text_secondary"
            android:textSize="9sp" />
    </RelativeLayout>

    <!-- Mileage Input Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:background="@drawable/bg_cyber_input"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp">

        <EditText
            android:id="@+id/etDialogIceMileage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:fontFamily="@font/space_grotesk"
            android:hint="42"
            android:imeOptions="actionDone"
            android:inputType="numberDecimal"
            android:selectAllOnFocus="true"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_muted"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono"
            android:text="KM / LITRE"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Quick Mileage Select Chips -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        android:weightSum="5">

        <TextView
            android:id="@+id/chipMileage35"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="35 km/L"
            android:textColor="@color/primary_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipMileage40"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="40 km/L"
            android:textColor="@color/primary_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipMileage42"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="42 km/L"
            android:textColor="@color/primary_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipMileage45"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="45 km/L"
            android:textColor="@color/primary_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/chipMileage50"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/jetbrains_mono"
            android:gravity="center"
            android:text="50 km/L"
            android:textColor="@color/primary_cyan"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ── 3. Live Dynamic Savings Impact Card ── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_savings_preview_box"
        android:orientation="vertical"
        android:padding="12dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_emerald"
                android:fontFamily="@font/jetbrains_mono"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="LIVE SAVINGS IMPACT"
                android:textColor="@color/black"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDialogPerKmSaved"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:fontFamily="@font/jetbrains_mono"
                android:text="₹2.26 / km cheaper"
                android:textColor="@color/secondary_green"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvDialogSavingsPreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/space_grotesk"
            android:text="₹2,260 Saved / 1,000 km"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDialogFuelAvoided"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/inter"
            android:text="Avoids ~23.8 L petrol • 55 kg CO₂ reduction"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- ── 4. Action Buttons ── -->
    <Button
        android:id="@+id/btnDialogApply"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_button_gradient_pill"
        app:backgroundTint="@null"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minHeight="0dp"
        android:fontFamily="@font/jetbrains_mono"
        android:text="APPLY &amp; RECALCULATE SAVINGS"
        android:textColor="@color/black"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnDialogResetDefault"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill_dark"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:fontFamily="@font/jetbrains_mono"
            android:text="Reset (₹104 @ 42 km/L)"
            android:textColor="@color/primary_cyan"
            android:textSize="10sp" />

        <Button
            android:id="@+id/btnDialogCancel"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:backgroundTint="@null"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:minHeight="0dp"
            android:fontFamily="@font/inter"
            android:text="Dismiss"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
