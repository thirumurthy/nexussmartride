<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Cyan Glow Halo -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="120dp"
                android:startColor="#4000E5FF"
                android:centerColor="#1800E5FF"
                android:endColor="#00000000" />
        </shape>
    </item>

    <!-- Outer Concentric Electric Ring -->
    <item
        android:bottom="8dp"
        android:left="8dp"
        android:right="8dp"
        android:top="8dp">
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="#8000E5FF"
                android:dashWidth="12dp"
                android:dashGap="6dp" />
            <solid android:color="#0800E5FF" />
        </shape>
    </item>

    <!-- Inner Solid Neon Core Ring -->
    <item
        android:bottom="24dp"
        android:left="24dp"
        android:right="24dp"
        android:top="24dp">
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="#CC00E5FF" />
            <solid android:color="#1A00E5FF" />
        </shape>
    </item>
</layer-list>
