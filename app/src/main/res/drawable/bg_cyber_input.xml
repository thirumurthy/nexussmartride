<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#19202E" />
            <corners android:radius="12dp" />
            <stroke android:width="1.5dp" android:color="@color/primary_cyan" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#151A25" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="#2A3446" />
        </shape>
    </item>
</selector>
